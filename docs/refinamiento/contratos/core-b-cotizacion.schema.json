{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Core B simulado — cotización volátil",
  "description": "Borrador de contrato externo. Los importes monetarios se expresan como texto decimal en pesos argentinos.",
  "oneOf": [
    { "$ref": "#/$defs/quoteRequest" },
    { "$ref": "#/$defs/quoteResponse" }
  ],
  "$defs": {
    "decimalArs": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.[0-9]{2}$" },
    "text": { "type": "string", "minLength": 1 },
    "quoteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetKind", "area", "amount", "currency", "quotedOn"],
      "properties": {
        "assetKind": { "enum": ["CYCLE", "E_CYCLE"] },
        "area": {
          "type": "object",
          "additionalProperties": false,
          "required": ["region", "postalCode"],
          "properties": {
            "region": { "$ref": "#/$defs/text" },
            "postalCode": { "type": "string", "pattern": "^[0-9]{4}$", "minLength": 4, "maxLength": 4 }
          }
        },
        "amount": { "$ref": "#/$defs/decimalArs" },
        "currency": { "const": "ARS" },
        "quotedOn": { "type": "string", "format": "date" },
        "discountBps": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "quoteResponse": {
      "oneOf": [
        { "$ref": "#/$defs/offered" },
        { "$ref": "#/$defs/noOffer" }
      ]
    },
    "offered": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "currency", "options"],
      "properties": {
        "result": { "const": "OK" },
        "currency": { "const": "ARS" },
        "options": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/option" } }
      }
    },
    "noOffer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result"],
      "properties": {
        "result": { "enum": ["NOT_ELIGIBLE", "BAD_RISK_DATA", "ASSET_UNSUPPORTED", "BUSY"] },
        "message": { "$ref": "#/$defs/text" }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "label", "total", "termDays", "paymentBasis", "benefits"],
      "properties": {
        "tier": { "$ref": "#/$defs/text" },
        "label": { "$ref": "#/$defs/text" },
        "total": { "$ref": "#/$defs/decimalArs" },
        "termDays": { "type": "integer", "minimum": 1 },
        "paymentBasis": { "enum": ["MONTH", "TERM"] },
        "benefits": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/benefit" } },
        "services": { "type": "array", "items": { "$ref": "#/$defs/text" } }
      }
    },
    "benefit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label"],
      "properties": {
        "key": { "$ref": "#/$defs/text" },
        "label": { "$ref": "#/$defs/text" },
        "active": { "type": "boolean" },
        "limit": { "$ref": "#/$defs/decimalArs" },
        "deductiblePct": { "type": "number", "minimum": 0, "maximum": 100 },
        "deductibleBasis": { "enum": ["LOSS", "COVERAGE_LIMIT"] }
      },
      "dependentRequired": {
        "deductiblePct": ["deductibleBasis"],
        "deductibleBasis": ["deductiblePct"]
      },
      "if": { "properties": { "active": { "const": true } }, "required": ["active"] },
      "else": {
        "not": { "anyOf": [{ "required": ["limit"] }, { "required": ["deductiblePct"] }] }
      }
    }
  }
}
